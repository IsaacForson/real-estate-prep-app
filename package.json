{
  "name": "real-estate-exam-prep",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint:content": "pnpm --filter @rep/content-lint run cli -- content",
    "pipeline": "pnpm --filter @rep/pipeline run cli --",
    "state-map": "pnpm --filter @rep/content-lint run cli -- --states-report content"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
