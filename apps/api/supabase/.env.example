# copy to supabase/.env.local and fill in. loaded by `pnpm functions:serve`
# (supabase functions serve --env-file supabase/.env.local). never commit .env.local.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# edge runtime (locally and hosted). do not set them here.

# hmac secret that signs item batches (SPEC §5.4). 32+ random bytes, base64 or hex.
#   openssl rand -hex 32
BATCH_SIGNING_SECRET=

# how long a signed batch stays valid, seconds (default 6h). client re-requests after expiry.
BATCH_TTL_SECONDS=21600

# storage bucket that holds per-batch json files (see config.toml [storage.buckets.batches])
BATCH_BUCKET=batches

# ---- paddle (web, merchant of record) --------------------------------------
# notification destination secret, starts with pdl_ntfset_. one per destination.
PADDLE_WEBHOOK_SECRET=
# price ids that map to our products
PADDLE_PRICE_ID_COMPLETE=
PADDLE_PRICE_ID_PASS_GUARANTEE=
# api key (pdl_live_ / pdl_sdbx_) so create-checkout can mint a hosted url
PADDLE_API_KEY=

# ---- lemon squeezy (web, merchant of record) --------------------------------
# signing secret you typed when creating the webhook in the dashboard
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID_COMPLETE=
LEMONSQUEEZY_VARIANT_ID_PASS_GUARANTEE=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# hosted buy links used when the API key is not set; create-checkout appends user_id
LEMONSQUEEZY_BUY_URL_COMPLETE=
LEMONSQUEEZY_BUY_URL_PASS_GUARANTEE=

# ---- revenuecat (ios + android iap) -----------------------------------------
# arbitrary value you set as the Authorization header in the revenuecat webhook config
REVENUECAT_WEBHOOK_AUTH=
# optional: hmac signing secret (dashboard > webhook > "HMAC webhook signing"). when set, the
# X-RevenueCat-Webhook-Signature header is verified in addition to Authorization.
REVENUECAT_WEBHOOK_SECRET=
# store product identifiers (same on both stores is simplest)
REVENUECAT_PRODUCT_ID_COMPLETE=rep_complete
REVENUECAT_PRODUCT_ID_PASS_GUARANTEE=rep_pass_guarantee
# accept SANDBOX events (local / testflight only)
REVENUECAT_ALLOW_SANDBOX=true

# ---- misc -------------------------------------------------------------------
# salt for hashing caller ips in audit_log (never store raw ips)
IP_HASH_SALT=

# ---- v2 (docs/V2_PLAN.md) ------------------------------------------------------
# help-ai: Groq OpenAI-compatible chat completions (free router keys live in the repo-root .env).
GROQ_API_KEY=
# override the help-ai model (default openai/gpt-oss-120b)
HELP_AI_MODEL=
# private bucket that `pipeline publish --remote` writes items/<bank>/<item_id>.json into
CONTENT_BUCKET=content
# local dev only: items missing from the content bucket get placeholder text instead of being dropped
CONTENT_STUB_MISSING=false
# optional: transactional email (ticket replies, re-verification) — the sender worker is not wired yet
BREVO_API_KEY=
