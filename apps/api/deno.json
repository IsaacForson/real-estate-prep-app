{
  "$comment": "root config for `deno check` / `deno test` / `deno lint` across all functions. each function also has its own deno.json (same imports) because the supabase cli bundles per function.",
  "nodeModulesDir": "none",
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.116.0",
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "lib": [
      "deno.window"
    ]
  },
  "tasks": {
    "check": "deno check supabase/functions/*/index.ts supabase/functions/**/*.test.ts",
    "test": "deno test supabase/functions",
    "lint": "deno lint supabase/functions",
    "fmt": "deno fmt supabase/functions",
    "fmt:check": "deno fmt --check supabase/functions"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
