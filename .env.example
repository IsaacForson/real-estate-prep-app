# Anthropic API — used only by packages/pipeline (drafting + verification).
# Leave unset if you use `ant auth login`; the SDK picks up the profile.
ANTHROPIC_API_KEY=

# Model used for item drafting and verification. Do not downgrade for cost;
# use the Batches API (50% off) instead — see docs/CONTENT_PIPELINE.md.
PIPELINE_MODEL=claude-opus-5

# Where the pipeline caches statute text and batch state (git-ignored).
PIPELINE_STATE_DIR=.pipeline

# ---- Free-tier LLM router (default backend) ----
LLM_BACKEND=router                      # router | anthropic
LLM_PROVIDER_ORDER=groq,cerebras,mistral,deepseek,nvidia
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEYS=                        # comma-separated; rotated on rate limits
# optional overrides: GROQ_MODEL, NVIDIA_MODEL, <PROVIDER>_MAX_INPUT_TOKENS, <PROVIDER>_RPM, LLM_CONCURRENCY, DRAFT_CHUNK_CHARS
